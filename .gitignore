# --- Rust / Cargo ---
# Compiled build output and executables
/target/

# rustfmt backup files
**/*.rs.bk

# MSVC debugging info (generated on Windows builds)
*.pdb

# Transient temp from build.rs's atomic Cargo.toml rewrite (BUMP=...)
Cargo.toml.tmp

# Cargo.lock is intentionally committed: this crate is a binary application,
# so the exact dependency versions are pinned for reproducible builds.
# (Do not add Cargo.lock here.)

# --- Secrets ---
# Android signing keystores live in CI secrets (ANDROID_KEYSTORE_BASE64), never
# in the repo. This guards against committing a local copy.
*.jks
*.keystore

# --- Editors / IDEs ---
/.vscode/
/.idea/
*.iml

# --- OS noise ---
Thumbs.db
Desktop.ini
.DS_Store
